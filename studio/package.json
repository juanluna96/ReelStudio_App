{
  "name": "reel-studio",
  "version": "0.2.0",
  "description": "Reel Studio: narrated explainer videos with Claude Code and Remotion",
  "author": "Cristian Alvarez",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=server --watch-path=shared server/index.ts",
    "desktop": "electron desktop/main.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.server.json",
    "test": "node --disable-warning=ExperimentalWarning --test server/*.test.ts desktop/*.test.ts",
    "dist": "node --disable-warning=ExperimentalWarning desktop/stage.ts && electron-builder --mac --arm64 --publish never",
    "dist:dir": "node --disable-warning=ExperimentalWarning desktop/stage.ts && electron-builder --mac --arm64 --dir --publish never"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@remotion/google-fonts": "^4.0.539",
    "@remotion/player": "^4.0.539",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "express": "^4.22.3",
    "lucide-react": "^1.66.0",
    "marked": "^18.1.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.539",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.5",
    "ws": "^8.22.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3"
  },
  "main": "desktop/main.ts",
  "build": {
    "appId": "dev.reelstudio.app",
    "productName": "Reel Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "server/**",
      "shared/**",
      "src/**",
      "index.html",
      "vite.config.ts",
      "tsconfig.json",
      "components.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/workspace",
        "to": "workspace"
      }
    ],
    "asar": false,
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "category": "public.app-category.video",
      "hardenedRuntime": false,
      "artifactName": "ReelStudio-${version}-${arch}.${ext}",
      "icon": "desktop/icon/icon.png"
    }
  }
}
